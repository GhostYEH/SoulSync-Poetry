# 生产环境 API 基础地址（默认为同域的 /api）
# 如果是跨域或者独立部署，填写真实的地址，例如 https://api.example.com/api
VITE_API_BASE_URL=/api

# 生产环境 Socket.io 地址（默认为同域）
# 如果是跨域或者独立部署，填写真实的地址，例如 https://api.example.com
VITE_SOCKET_URL=

# Unity WebGL 数字人构建地址（默认使用 /digital-human/index.html）
VITE_DIGITAL_HUMAN_WEBGL_URL=/digital-human/index.html
