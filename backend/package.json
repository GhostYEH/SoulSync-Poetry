{
  "name": "chinese-poetry-backend",
  "version": "1.0.0",
  "description": "Backend for Chinese Poetry Learning System with AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/apiSmokeTest.js && node tests/gameMechanicsTest.js",
    "test:smoke": "node tests/apiSmokeTest.js",
    "test:sqlite": "node tests/dbModeTest.js",
    "test:security": "node tests/securityTest.js",
    "test:transaction": "node tests/transactionTest.js",
    "test:cheat": "node tests/antiCheatTest.js",
    "test:all": "node tests/dbModeTest.js && node tests/apiSmokeTest.js && node tests/securityTest.js && node tests/transactionTest.js && node tests/antiCheatTest.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:students": "node scripts/seedStudentDemoData.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "opencc-js": "^1.0.5",
    "pg": "^8.22.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "chinese-poetry",
    "ai",
    "learning-system"
  ],
  "author": "",
