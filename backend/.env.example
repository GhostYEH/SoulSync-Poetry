# ==================== 数据库配置 ====================
# [Required] PostgreSQL 连接串
DATABASE_URL=

# [Optional] 数据库连接池配置
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONN_TIMEOUT=5000
# DB_QUERY_TIMEOUT=10000

# ==================== AI API 配置 ====================
# [Optional] 硅基流动（推荐，免费额度，支持 OpenAI 兼容接口）
SILICONFLOW_API_KEY=

# [Optional] 阿里云百炼（dashscope）
# ALIYUN_BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=

# [Optional] 智谱清言
# ZHIPU_API_KEY=

# [Optional] 自定义 API 地址
# AI_API_URL=

# [Optional] 自定义模型
# AI_MODEL=

# ==================== 服务器配置 ====================
# [Optional] 端口号，默认 3000
PORT=3000

# [Optional] 主机，默认 localhost
HOST=localhost

# [Optional] 运行环境：development | production | test
NODE_ENV=development

# ==================== 限流配置 ====================
# [Optional] 认证接口限流
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20

# [Optional] AI 接口限流
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=10

# ==================== CORS 配置 ====================
# [Optional] 逗号分隔的允许来源，开发环境可用 *
ALLOWED_ORIGINS=*

# ==================== JWT 配置 ====================
# [Required] JWT 密钥，生产环境必须为至少32字符的随机字符串
JWT_SECRET=

# [Optional] JWT 过期时间
JWT_EXPIRES_IN=24h