# ==================== 数据库配置 ====================
# DB_TYPE: auto | postgres | sqlite
#   auto      - 优先 PostgreSQL，连接失败则进程级降级到 SQLite
#   postgres  - 仅 PostgreSQL，连接失败直接报错
#   sqlite    - 仅 SQLite，不尝试 PostgreSQL
DB_TYPE=auto

# PostgreSQL 连接串
DATABASE_URL=postgresql://user:password@localhost:5432/poetry_db

# SQLite 文件路径（DB_TYPE=sqlite 或 auto 降级时使用）
DB_PATH=./db/poetry.db

# ==================== AI API 配置 ====================
# 智谱普通文本模型（OpenAI 兼容接口）
# 在 https://open.bigmodel.cn/ 创建 API Key
ZHIPU_API_KEY=
ZHIPU_MODEL=GLM-4-Flash-250414

# 智谱失败时的备用文本模型：讯飞星火 Spark Lite HTTP APIPassword
SPARK_API_PASSWORD=
SPARK_MODEL=lite

# 阿里云百炼（dashscope）
# ALIYUN_BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=

# 可选：自定义智谱 API 地址
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ==================== 服务器配置 ====================
PORT=3000
HOST=localhost
NODE_ENV=development

# ==================== CORS 配置 ====================
# 逗号分隔的允许来源，开发环境可用 *
ALLOWED_ORIGINS=*

# ==================== JWT 配置 ====================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h
