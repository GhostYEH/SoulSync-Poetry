# ==================== 数据库配置 ====================
# DB_TYPE: auto | postgres | sqlite
#   auto      - 优先 PostgreSQL，连接失败则进程级降级到 SQLite
#   postgres  - 仅 PostgreSQL，连接失败直接报错
#   sqlite    - 仅 SQLite，不尝试 PostgreSQL
DB_TYPE=auto

# PostgreSQL 连接串
DATABASE_URL=

# SQLite 文件路径（DB_TYPE=sqlite 或 auto 降级时使用）
DB_PATH=./db/poetry.db

# ==================== AI API 配置 ====================
# 智谱普通文本模型（OpenAI 兼容接口）
# 在 https://open.bigmodel.cn/ 创建 API Key
ZHIPU_API_KEY=
ZHIPU_MODEL=GLM-4-Flash-250414

# 智谱失败时的备用文本模型：讯飞星火 Spark Lite HTTP APIPassword
SPARK_API_PASSWORD=
SPARK_MODEL=lite

# 阿里云百炼（dashscope）
# ALIYUN_BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=

# 可替换文生图 Provider（未配置时详情页自动使用项目内 fallback 背景）
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_PROMPT_VERSION=v3

# Xiaomi MiMo 语音合成（mimo-v2.5-tts）
# 请在本机 backend/.env 中填写，不要提交真实密钥
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉
# 可选：MiMo 的 user 消息，用于控制朗读风格
MIMO_TTS_STYLE=普通话，温柔自然，吐字清晰，语速舒缓，适合朗读古诗词。
MIMO_TTS_TIMEOUT_MS=60000

# 可选：自定义智谱 API 地址
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ==================== 服务器配置 ====================
PORT=3000
HOST=localhost
NODE_ENV=development

# ==================== CORS 配置 ====================
# 逗号分隔的允许来源，开发环境可用 *
ALLOWED_ORIGINS=*

# ==================== JWT 配置 ====================
JWT_SECRET=
JWT_EXPIRES_IN=24h
