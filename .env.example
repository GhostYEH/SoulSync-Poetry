# ==================== 项目环境变量 ====================

# ==================== 数据库配置 ====================
# [Required] PostgreSQL 连接串
DATABASE_URL=

# ==================== AI API 配置 ====================
# [Optional] 智谱普通文本模型（OpenAI 兼容接口）
ZHIPU_API_KEY=
ZHIPU_MODEL=GLM-4-Flash-250414

# 智谱失败时的备用文本模型：讯飞星火 Spark Lite HTTP APIPassword
SPARK_API_PASSWORD=
SPARK_MODEL=lite

# [Optional] 阿里云百炼（dashscope）
# ALIYUN_BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=

# [Optional] Xiaomi MiMo 语音合成（mimo-v2.5-tts）
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICE=茉莉
# MIMO_TTS_STYLE=普通话，温柔自然，吐字清晰，语速舒缓，适合朗读古诗词。
# MIMO_TTS_TIMEOUT_MS=60000

# [Optional] 自定义智谱 API 地址
# ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ==================== 服务器配置 ====================
# [Optional] 端口号，默认 3000
PORT=3000

# [Optional] 运行环境：development | production | test
NODE_ENV=development

# ==================== CORS 配置 ====================
# [Optional] 逗号分隔的允许来源，开发环境可用 *
ALLOWED_ORIGINS=*

# ==================== JWT 配置 ====================
# [Required] JWT 密钥，生产环境必须为至少32字符的随机字符串
JWT_SECRET=

# ==================== 前端环境变量 ====================
# [Optional] 后端 API 基础地址
# VITE_API_BASE_URL=

# [Optional] 后端 WebSocket 地址
# VITE_SOCKET_URL=
# ==================== 诗词详情页可插拔 AI 能力 ====================
# 均可留空；留空时使用项目内意境背景与浏览器语音 fallback。
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_PROMPT_VERSION=v3
