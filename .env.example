# ==================== 项目环境变量 ====================

# ==================== 数据库配置 ====================
# [Required] PostgreSQL 连接串
DATABASE_URL=

# ==================== AI API 配置 ====================
# [Optional] 硅基流动（推荐，免费额度，支持 OpenAI 兼容接口）
SILICONFLOW_API_KEY=

# [Optional] 阿里云百炼（dashscope）
# ALIYUN_BAILIAN_API_KEY=
# DASHSCOPE_API_KEY=

# [Optional] 智谱清言
# ZHIPU_API_KEY=

# ==================== 服务器配置 ====================
# [Optional] 端口号，默认 3000
PORT=3000

# [Optional] 运行环境：development | production | test
NODE_ENV=development

# ==================== CORS 配置 ====================
# [Optional] 逗号分隔的允许来源，开发环境可用 *
ALLOWED_ORIGINS=*

# ==================== JWT 配置 ====================
# [Required] JWT 密钥，生产环境必须为至少32字符的随机字符串
JWT_SECRET=

# ==================== 前端环境变量 ====================
# [Optional] 后端 API 基础地址
# VITE_API_BASE_URL=

# [Optional] 后端 WebSocket 地址
# VITE_SOCKET_URL=
